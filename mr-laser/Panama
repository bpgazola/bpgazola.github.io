                labels: ['Preço Competitivo', 'Tecnologia', 'Suporte Técnico', 'Marketing Digital', 'Presença de Marca'],
                mrLaser: [70, 95, 90, 80, 40], // Strong tech/support, weak brand initially
                compA: [60, 70, 50, 85, 95], // Market Leader: Strong brand, weak support
                compB: [95, 50, 40, 60, 50]  // Low Cost: High price score (cheap), low quality
            },
            financials: {
                conservative: {
                    x: ['Ano 1', 'Ano 2', 'Ano 3'],
                    y: [850000, 1200000, 1800000],
                    breakeven: 'Mês 14',
                    roi: '22%'
                },
                optimistic: {
                    x: ['Ano 1', 'Ano 2', 'Ano 3'],
                    y: [1200000, 2100000, 3200000],
                    breakeven: 'Mês 9',
                    roi: '45%'
                }
            },
            investment: {
                labels: ['Estoque Inicial', 'Marketing & Launch', 'Legal & Regulatório', 'Equipe & Escritório'],
                values: [40, 25, 15, 20] // Percentages
            }
        };

        // --- Initialization ---
        document.addEventListener('DOMContentLoaded', () => {
            renderNavigation();
            initCharts();
            renderFinancialPlot();
        });

        // --- Navigation Logic ---
        const tabs = [
            { id: 'overview', label: 'Visão Geral' },
            { id: 'customer', label: 'Cliente & Segmentos' },
            { id: 'competition', label: 'Concorrência' },
            { id: 'strategy', label: 'Operações' },
            { id: 'financials', label: 'Financeiro' }
        ];

        function renderNavigation() {
            const navContainer = document.getElementById('nav-container');
            navContainer.innerHTML = tabs.map(tab => `
                <button 
                    onclick="switchTab('${tab.id}')"
                    class="${tab.id === state.currentTab ? 'tab-active' : 'tab-inactive'} inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors duration-200"
                >
                    ${tab.label}
                </button>
            `).join('');

            // Mobile nav handling could be added here
        }

        function switchTab(tabId) {
            state.currentTab = tabId;
            renderNavigation();
            
            // Hide all sections
            tabs.forEach(tab => {
                document.getElementById(`section-${tab.id}`).classList.add('hidden');
            });
            
            // Show active section
            const activeSection = document.getElementById(`section-${tabId}`);
            activeSection.classList.remove('hidden');
            activeSection.classList.add('animate-fade-in');

            // Trigger resize for charts in newly visible tab to ensure correct rendering
            window.dispatchEvent(new Event('resize'));
            
            // Specific re-renders if needed
            if(tabId === 'financials') renderFinancialPlot();
        }

        // --- Chart Generation ---
        let charts = {};

        function initCharts() {
            // 1. Market Growth (Line)
            const ctxGrowth = document.getElementById('marketGrowthChart').getContext('2d');
            charts.growth = new Chart(ctxGrowth, {
                type: 'line',
                data: {
                    labels: data.marketGrowth.labels,
                    datasets: [{
                        label: 'Tamanho de Mercado (USD Milhões)',
                        data: data.marketGrowth.values,
                        borderColor: '#0EA5E9',
                        backgroundColor: 'rgba(14, 165, 233, 0.1)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: false } }
                }
            });

            // 2. Segmentation (Donut)
            const ctxSeg = document.getElementById('segmentationChart').getContext('2d');
            charts.segmentation = new Chart(ctxSeg, {
                type: 'doughnut',
                data: {
                    labels: data.segmentation.labels,
                    datasets: [{
                        data: data.segmentation.values,
                        backgroundColor: data.segmentation.colors,
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { position: 'right' } 
                    },
                    cutout: '70%'
                }
            });

            // 3. Buying Criteria (Horizontal Bar)
            const ctxCrit = document.getElementById('buyingCriteriaChart').getContext('2d');
            charts.criteria = new Chart(ctxCrit, {
                type: 'bar',
                data: {
                    labels: data.buyingCriteria.labels,
                    datasets: [{
                        label: 'Importância (0-100)',
                        data: data.buyingCriteria.values,
                        backgroundColor: '#6366F1',
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } }
                }
            });

            // 4. Competitor Radar
            const ctxRadar = document.getElementById('competitionRadarChart').getContext('2d');
            charts.radar = new Chart(ctxRadar, {
                type: 'radar',
                data: {
                    labels: data.competitorRadar.labels,
                    datasets: [
                        {
                            label: 'MR Laser',
                            data: data.competitorRadar.mrLaser,
                            fill: true,
                            backgroundColor: 'rgba(14, 165, 233, 0.2)',
                            borderColor: '#0EA5E9',
                            pointBackgroundColor: '#0EA5E9'
                        },
                        {
                            label: 'Competidor A (Líder)',
                            data: data.competitorRadar.compA,
                            fill: true,
                            backgroundColor: 'rgba(239, 68, 68, 0.1)',
                            borderColor: '#EF4444',
                            pointBackgroundColor: '#EF4444',
                            borderDash: [5, 5]
                        },
                        {
                            label: 'Competidor B (Low Cost)',
                            data: data.competitorRadar.compB,
                            fill: true,
                            backgroundColor: 'rgba(234, 179, 8, 0.1)',
                            borderColor: '#EAB308',
                            pointBackgroundColor: '#EAB308',
                            borderDash: [2, 2]
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            angleLines: { display: true },
                            suggestedMin: 0,
                            suggestedMax: 100
                        }
                    }
                }
            });

            // 5. Investment Breakdown (Pie)
            const ctxInv = document.getElementById('investmentChart').getContext('2d');
            charts.investment = new Chart(ctxInv, {
                type: 'pie',
                data: {
                    labels: data.investment.labels,
                    datasets: [{
                        data: data.investment.values,
                        backgroundColor: ['#3B82F6', '#10B981', '#F59E0B', '#6B7280']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'right' } }
                }
            });
        }

        // --- Plotly Financial Chart ---
        function renderFinancialPlot() {
            const scenario = data.financials[state.financialScenario];
            
            const trace = {
                x: scenario.x,
                y: scenario.y,
                type: 'bar',
                marker: {
                    color: state.financialScenario === 'conservative' ? '#64748B' : '#10B981',
                    opacity: 0.8
                },
                name: 'Receita Projetada'
            };

            const layout = {
                title: false,
                xaxis: { title: 'Período' },
                yaxis: { title: 'Receita (USD)', gridcolor: '#f3f4f6' },
                paper_bgcolor: 'rgba(0,0,0,0)',
                plot_bgcolor: 'rgba(0,0,0,0)',
                margin: { t: 20, l: 50, r: 20, b: 40 },
                showlegend: false
            };

            const config = { responsive: true, displayModeBar: false };

            Plotly.newPlot('financialPlot', [trace], layout, config);
        }

        function updateFinancialScenario(type) {
            state.financialScenario = type;
            
            // Update buttons
            const btnCons = document.getElementById('btn-conservative');
            const btnOpt = document.getElementById('btn-optimistic');
            
            if(type === 'conservative') {
                btnCons.className = "px-4 py-2 text-sm font-medium rounded-md transition bg-white shadow text-gray-900";
                btnOpt.className = "px-4 py-2 text-sm font-medium rounded-md transition text-gray-500 hover:text-gray-900";
            } else {
                btnOpt.className = "px-4 py-2 text-sm font-medium rounded-md transition bg-white shadow text-gray-900";
                btnCons.className = "px-4 py-2 text-sm font-medium rounded-md transition text-gray-500 hover:text-gray-900";
            }

            // Update Labels
            document.getElementById('breakeven-label').innerText = data.financials[type].breakeven;
            document.getElementById('roi-label').innerText = data.financials[type].roi;
            document.getElementById('roi-label').className = type === 'optimistic' ? "text-sm font-bold text-green-600" : "text-sm font-bold text-blue-600";

            renderFinancialPlot();
        }

        // --- SWOT Interaction ---
        function highlightSwot(type) {
            const details = {
                strengths: "Diferencial DMC: Equipamentos com maior densidade de potência e durabilidade. O 'Made in Brazil' em med-tech é bem visto na LATAM.",
                weaknesses: "Necessidade de alto investimento inicial em marketing para gerar awareness. Falta de histórico local pode atrasar vendas para governo.",
                opportunities: "Expansão para províncias do interior (Chiriquí, Veraguas) onde a concorrência é baixa. Oferta de cursos de capacitação.",
                threats: "Mudanças repentinas nas taxas de importação ou atrasos na ANVISA local (Farmacia y Drogas) podem impactar o go-to-market."
            };
            
            const detailBox = document.getElementById('swot-detail');
            detailBox.innerText = details[type];
            detailBox.className = "mt-4 p-3 bg-white border border-gray-200 rounded text-sm text-gray-700 shadow-sm animate-pulse-once";
        }

    </script>
</body>
</html>
